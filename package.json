{
  "name": "pons-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Launch a token through the ponsfamily.com launchpad with an atomic dev buy, then fire a bundle of pre-signed buys behind it (Robinhood Chain).",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm start --workspace backend",
    "test": "npm test --workspace backend",
    "user:add": "npm run user:add --workspace backend --",
    "user:list": "npm run user:list --workspace backend",
    "user:remove": "npm run user:remove --workspace backend --",
    "archive:list": "npm run archive:list --workspace backend --",
    "archive:restore": "npm run archive:restore --workspace backend --",
    "archive:purge": "npm run archive:purge --workspace backend --",
    "v2:watch": "npm run v2:watch --workspace backend --"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
