# ── pons-launcher ────────────────────────────────────────────────────────────
# Launch a ponsfamily.com token with an atomic dev buy + a bundle of buys behind
# it. Defaults are SAFE: DRY_RUN=true simulates everything and sends nothing.

# Nothing is broadcast while this is true. Flip to false only when you mean it.
DRY_RUN=true

PORT=3100
# Bind address. Keep 127.0.0.1 in production and let nginx be the only way in.
HOST=127.0.0.1

# ── Chain (Robinhood Chain mainnet) ──────────────────────────────────────────
RPC_URL=https://YOUR-ENDPOINT.robinhood-mainnet.quiknode.pro/YOUR_TOKEN/
CHAIN_ID=4663
EXPLORER_URL=https://robinhoodchain.blockscout.com

# ── Pons launchpad ───────────────────────────────────────────────────────────
# The live PonsLaunchFactory (verified 2026-07-13, still launching 2026-07-25).
# Validated at boot by reading launchFee + the config list. Previous deployment,
# usable as a fallback: 0x966ffA3957a6d3621D3EfC96E22160806f0EF141
FACTORY_ADDRESS=0xA5aAb3F0c6EeadF30Ef1D3Eb997108E976351feB

# The swap router is normally READ from the selected dex config. Set this only
# to override that (leave blank in normal operation).
SWAP_ROUTER=

# ── Logo / IPFS ──────────────────────────────────────────────────────────────
# The token logo is pinned through ponsfamily's own uploader, so the ipfs://
# URI that goes on chain is the same kind their site produces. Both URLs are
# undocumented third-party endpoints — override here if they move.
PONS_IPFS_UPLOAD_URL=https://pons-vercel-data-gateway.ozzy-6de.workers.dev/public/ipfs/image
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
# The worker refuses requests without an allowlisted Origin (403). We present
# their own site's origin, as their upload form does.
PONS_IPFS_ORIGIN=https://www.ponsfamily.com

# ── Keys ─────────────────────────────────────────────────────────────────────
# Encrypts the wallet keystore at rest (AES-256-GCM, scrypt-derived). REQUIRED
# when DRY_RUN=false. Lose this and the stored keys are unrecoverable.
KEYSTORE_PASSPHRASE=

# How many DELETED wallets the recovery archive keeps, per user. Past this, the
# oldest deleted key is DESTROYED to make room — permanently, and recoverable
# only from a backup file already downloaded.
#
# ONE ARCHIVE SERVES EVERY TAB and eviction ignores roles, so deleting V4 seed
# wallets in bulk can destroy an archived v1 dev key. 100 was chosen when a
# keystore held tens of wallets; V4 discards them by the hundred. Raise it if
# you use V4 — the only cost of a larger archive is disk.
ARCHIVE_MAX=100

# Required on every mutating API route. Blank = open (dev only). SET THIS in
# production — the box is internet-reachable.
API_KEY=

# ── Admin ────────────────────────────────────────────────────────────────────
# Users who may read OTHER users' activity logs (read-only, that log only —
# wallets, keys and launch history stay isolated with no exception). Comma-
# separated ids, as printed by `npm run user:list`. Blank — the default — means
# nobody is an admin and every log is private.
#
# This is the only way to grant it. No API route sets it, deliberately: an
# admin bit that could be set over the API would be reachable with a stolen
# key. Changing it needs shell access and a restart.
#
# Every log an admin opens is written into THAT ADMIN's own activity log.
ADMIN_USERS=

# ── Relay (v2 bundle funding) ────────────────────────────────────────────────
# The v2 bundle wallets are funded through Relay solver orders. Relay rate-limits
# per IP with a small budget (measured: ~5 quotes, then HTTP 429 "Could not
# process request. Please try again later." — and hammering while blocked keeps
# it blocked). That budget is SHARED with the seasoning campaigns and v3. So the
# quotes go out BATCH_SIZE at a time (1 = strictly serial), GAP_MS apart, and a
# 429 waits BACKOFF_MS (growing per attempt, up to RETRIES times) rather than
# retrying fast. TIMING ONLY — amounts and deposits are unchanged. If a big run
# still trips it (or campaigns are busy), raise the gap/backoff. A 10-wallet run
# at these defaults takes ~40s; funding is not time-critical.
RELAY_API_URL=https://api.relay.link
# Relay API key from dashboard.relay.link (API keys tab). Sent as x-api-key on
# every Relay call — v2, v3 and the campaigns. Lifts /quote from the anonymous
# ~5-per-window per-IP limit to 50/min, so with a key set you can relax the
# pacing below (e.g. RELAY_QUOTE_GAP_MS=1500, RELAY_QUOTE_BATCH_SIZE=2). Blank =
# anonymous.
RELAY_API_KEY=
RELAY_QUOTE_BATCH_SIZE=1
RELAY_QUOTE_GAP_MS=4000
RELAY_QUOTE_RETRIES=5
RELAY_QUOTE_BACKOFF_MS=20000

# What the PROXY in front of this process waits for, in ms. Not enforced here —
# it is nginx's proxy_read_timeout (deploy/nginx.conf and deploy/nginx-rhbond.conf
# both set 180s), and the app holds it only so the console can warn BEFORE a long
# request is sent. The untimed v2 Relay funding run quotes every wallet before it
# sends any deposit, so 30 wallets at RELAY_QUOTE_GAP_MS=15000 is 450s against a
# 180s ceiling: 504 Gateway Time-out, while the deposits keep going out on the
# server. Change this ONLY together with the nginx directive — set larger than
# nginx actually waits and the console stops warning about a trap that is still
# armed. 0 = no proxy in front, warning off.
GATEWAY_TIMEOUT_MS=180000

# ── Bundle behaviour ─────────────────────────────────────────────────────────
# Native ETH left behind in each bundle wallet when buying "entire balance",
# so the wallet can still pay for the buy's own gas.
GAS_BUFFER_ETH=0.0004

# What a V3 BUNDLE WALLET keeps back after its buy, so it can still pay to SELL later.
# GAS_BUFFER_ETH alone does not cover an exit: a native sell is approve+sell, and a
# token-quoted (route) sell is approve x2 + sell + swap, which costs more than the buffer
# left behind - so every bundle wallet on a routed curve ended the run unable to fund its
# own exit and the exit skipped it, stranding the tokens. This reserve is held out of the
# buy AND added to the funding floor, so a wallet is never funded with only gas + reserve
# and nothing to buy with. Raising it also raises the smallest viable big buy.
# 0 restores the old behaviour (spend everything but gas).
# RANDOMISED PER WALLET within this band, so the leftovers are not an identical figure
# across a run -- a uniform remainder is itself a pattern. ~$20-$30 at $2500/ETH.
V3_KEEP_BACK_MIN_ETH=0.008
V3_KEEP_BACK_MAX_ETH=0.012

# IT ADAPTS TO SMALL BUYS. The band above is what a healthy buy keeps; on a small slice it
# would be most of the buy, so the reserve is capped at this SHARE of what actually arrived
# and never drops below the floor. The floor must still cover an exit sell (approve x2 +
# sell + swap on a routed curve, ~0.00065 ETH) or the wallet ends holding tokens it cannot
# sell. The share cap is also what keeps the buy positive for any wallet that cleared the
# funding floor, so raising the band can never make a buy fail for want of gas.
V3_KEEP_BACK_FLOOR_ETH=0.0015
V3_KEEP_BACK_MAX_SHARE_PCT=25

# A FIXED override for both ends of the band. 0 restores spend-everything-but-gas.
# V3_KEEP_BACK_ETH=0

# Gas limit used for each pre-signed bundle buy. Pre-signing happens before the
# pool exists, so the buy cannot be estimated against a live pool.
BUY_GAS_LIMIT=400000

# ── V4 seed wallet seasoning ────────────────────────────────────────────────
# How long a funded V4 seed must age before V1/V3 may claim it as a bundle wallet.
SEASONED_MIN_HOURS=24

# ── Take-profit dApp (dapp.rhbond.xyz) ───────────────────────────────────────
# The PUBLIC sell page. It holds no key: a visitor's keys stay in their browser,
# and this backend only reads chain state, indexes trades for the chart and
# relays transactions the browser already signed. Everything here is optional.
#
# The Host the dApp is served on. A request carrying this Host gets the dApp page,
# its /dapp/assets and /api/tp/* ONLY; every other /api route answers 404 for it,
# and so do the console page's /assets. This is
# the server's half of the allowlist deploy/nginx-rhbond.conf also enforces, so
# keep the two in step if the hostname ever changes.
DAPP_HOST=dapp.rhbond.xyz

# How many tokens the chart indexer follows at once. Each one polls getLogs every
# 400 ms on the dApp's own RPC connection (never the console's send path), and
# stops 5 minutes after its last viewer leaves. Opening a token past the cap is
# refused ('too_many') until a slot frees.
TP_MAX_TOKENS=30

# Optional: a second endpoint (the chain's sequencer, to skip a hop). When set,
# every signed dApp transaction is ALSO sent there, at the same time as RPC_URL; a
# duplicate send of the same signed transaction is harmless. Leave blank to use
# RPC_URL only.
TP_SEQUENCER_URL=

# Tunables with working defaults — uncomment only to change one.
# The dApp's public reads (wallets, marks, fees, quotes, venue lookups) run on their
# OWN socket pool with a process-wide cap on requests in flight, its receipt polls on
# a smaller pool and cap of their own (a click's quote never queues behind them), and
# its broadcasts on another pool — never the console's keep-alive pool that a launch
# bundle fires through. They still spend RPC_URL's provider quota unless
# TP_READ_RPC_URL (and TP_CHART_RPC_URL below) point elsewhere, e.g. the public RPC;
# the receipt polls follow TP_READ_RPC_URL:
# TP_READ_RPC_URL=
# TP_READ_CONCURRENCY=12
# TP_READ_MAX_SOCKETS=12
# TP_RECEIPT_CONCURRENCY=4
# TP_RECEIPT_MAX_SOCKETS=4
# TP_SEND_MAX_SOCKETS=100
# Receipt hashes watched at once, process-wide (the page's sweep settles the rest):
# TP_WATCH_MAX=2000
# The chart indexer's own RPC (default RPC_URL — the same quota as the console's
# sends, so a separate endpoint is worth setting), its per-request timeout, and how
# many chart RPC calls run at once across every indexer:
# TP_CHART_RPC_URL=
# TP_CHART_RPC_TIMEOUT_MS=15000
# TP_CHART_CONCURRENCY=2
# The chart's optional WebSocket push: it only wakes the getLogs poll early, never
# feeds the chart itself. Default: the chart RPC URL as ws(s)://; 'off' disables it.
# TP_CHART_WSS_URL=
# Per-IP limits (nginx's limit_req is the first line; these hold if it is bypassed).
# An IPv6 visitor is one /64. A /wallets read costs one read per 20 addresses. POST
# /quote has its own bucket, so a click's exact quote never waits on the page's other
# reads. A visitor streams at most TP_TOKENS_PER_IP distinct tokens at once (the
# indexer registry is TP_MAX_TOKENS for everyone). Signed transactions are costed
# per tx: sells and swaps in one bucket, approvals (ERC-20 and Permit2) in their
# own, so arming can never spend the sell budget:
# TP_READS_PER_MIN=120
# TP_QUOTES_PER_MIN=120
# TP_TOKENS_PER_IP=3
# TP_BROADCAST_TX_PER_MIN=600
# TP_APPROVE_TX_PER_MIN=300
# TP_STREAMS_PER_IP=5
# Quote refusal caps, in bps of price impact: a token sell, and the pair -> ETH leg:
# TP_MAX_SELL_IMPACT_BPS=5000
# TP_PAIR_MAX_IMPACT_BPS=1000
# Token logos (GET /api/tp/logo/:ca) are fetched by the server. An IPFS logo is fetched
# from these gateways only, in order (prefix|timeout ms, comma-separated, https only),
# never from the host its logo text names. Default: ponsfamily's own gateway, then
# Filebase, then Pinata. A 451 from any of them is final (moderated content is not
# fetched elsewhere):
# TP_LOGO_GATEWAYS=https://pons-vercel-data-gateway.ozzy-6de.workers.dev/public/ipfs/|4000,https://ipfs.filebase.io/ipfs/|4000,https://gateway.pinata.cloud/ipfs/|10000
# A logo on an ordinary https host is fetched through an SSRF-safe GET instead
# (tp/safeFetch.js): port 443 only, every DNS answer must be a public address and the
# connection is pinned to it, at most 2 redirects, 5 s in all. Nothing to set.
# The largest logo served (bytes: 3 MiB, at most 5 MiB; a larger one becomes an
# identicon), the in-memory logo cache, how long a failed logo waits before a retry,
# and how many logo requests run at once:
# TP_LOGO_MAX_BYTES=3145728
# TP_LOGO_CACHE_BYTES=67108864
# TP_LOGO_RETRY_MS=600000
# TP_LOGO_CONCURRENCY=3
# How long a logo request may wait in all (from arrival, across every gateway hop)
# before it is answered 404 no-store instead, and how many fetches one caller (its IP)
# may have in flight at once. Together they stop one visitor's dead CIDs from owning
# the three slots while everyone else's logo queues behind them:
# TP_LOGO_WAIT_MS=25000
# TP_LOGO_PER_CALLER=2

# ── The dApp account: sign in with a wallet, saved wallets synced ENCRYPTED ──
# A visitor signs in with their wallet (Sign-In-With-Ethereum) and their wallet list
# is kept here ENCRYPTED: the key is derived in their browser from a signature that
# never reaches this server, so these files are ciphertext this server cannot read.
# Nothing to set for production; every line below is optional.
#
# Where the encrypted lists (vaults/, 0600 files in a 0700 directory), the deleted
# lists kept for a hand restore (deleted/), the session signing secret (session.key:
# delete it to sign everyone out) and revoked.json live. Back it up with the droplet.
# Default: backend/data/tp-accounts
# TP_ACCOUNTS_DIR=
# The page origin the sign-in message names, and the Origin every account write must
# carry. Default https://$DAPP_HOST. The account API answers on DAPP_HOST only, so
# local dev through the Vite proxy runs the backend with DAPP_HOST=127.0.0.1 and
# TP_SIWE_ORIGIN=http://localhost:5173; a page served on http://127.0.0.1:3199 needs
# TP_SIWE_ORIGIN=http://127.0.0.1:3199.
# TP_SIWE_ORIGIN=https://dapp.rhbond.xyz
# Store caps: ciphertext bytes per list, lists, and bytes on disk in total. nginx's
# /api/tp/account/ body cap (400k) fits TP_VAULT_MAX_BYTES up to about 290 KiB.
# TP_VAULT_MAX_BYTES=262144
# TP_VAULT_MAX_ACCOUNTS=5000
# TP_VAULT_MAX_TOTAL_BYTES=536870912
# Of that total, what the kept DELETED copies may hold (default a quarter). They have
# their own budget so that one address's tombstones can never make another visitor's
# save answer 507; when it is full, expired copies go first and then the oldest copy
# that can be spared (an address's latest before anyone's first), so a delete is
# never refused for space:
# TP_VAULT_MAX_DELETED_BYTES=134217728
# Days a DELETED list (and its .prev) is kept under deleted/ so it can be restored by
# hand (README "Take-profit dApp"): a stolen session can delete a list but not erase
# it. Two deletions of an address are kept in the window: the first (never replaced)
# and the latest (each new deletion replaces it), and the budget above may evict a
# spare copy sooner. 0 = erase at once
# (and, at the next start, whatever an earlier setting kept):
# TP_VAULT_KEEP_DELETED_DAYS=30
# Bytes of revoked.log (one appended line per delete) before it is compacted into
# revoked.json. A delete costs one line whatever the size of the map:
# TP_VAULT_REVOKED_LOG_MAX_BYTES=1048576
# Per-IP limits; writes also per signed-in address, and new lists per IP per hour:
# TP_ACCOUNT_NONCES_PER_MIN=10
# TP_ACCOUNT_LOGINS_PER_MIN=10
# TP_ACCOUNT_READS_PER_MIN=60
# TP_ACCOUNT_WRITES_PER_MIN_IP=60
# TP_ACCOUNT_WRITES_PER_MIN=30
# TP_ACCOUNT_CREATES_PER_HOUR=5
